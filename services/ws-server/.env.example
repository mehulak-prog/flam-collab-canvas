# M4 - Real-Time Sync Engine (ws-server)
PORT=1234

# Not required by Hocuspocus itself, kept here only so this service's .env
# mirrors the shared root .env.example. Do NOT rename.
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# M9 - Snapshot Persistence
# Same shared name/value as web/.env.local's DATABASE_URL - this service
# now also connects directly to Postgres to read/write snapshots.
DATABASE_URL=
